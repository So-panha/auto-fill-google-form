{
  "version": 2,
  "builds": [
    {
      "src": "backend-site/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-site/app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend-site/api/routes"
    },
    {
      "source": "/(.*)",
      "destination": "frontend-site/app/$1"
    }
  ]
}