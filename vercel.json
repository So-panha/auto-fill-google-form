{
  "version": 2,
  "installCommand": "yum install -y chromium chromium-chromedriver",
  "builds": [
    {
      "src": "backend-site/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-site/app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
        "source": "/api/(.*)",
        "destination": "backend-site/index.py?html_path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "frontend-site/app/$1"
    }
  ]
}